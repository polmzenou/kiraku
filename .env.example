# Copie ce fichier en .env.local et remplis les valeurs (jamais de NEXT_PUBLIC_).

# PostgreSQL 17. En production : la base du VPS, sur la même machine que l'app (127.0.0.1:5432, port fermé
# au pare-feu). DIRECT_URL sert aux migrations (prisma.config.ts) ; sans pooler, la même URL que DATABASE_URL.
DATABASE_URL="postgresql://kiraku:<mot-de-passe>@127.0.0.1:5432/kiraku"
DIRECT_URL="postgresql://kiraku:<mot-de-passe>@127.0.0.1:5432/kiraku"

# Tests d'intégration : base isolée et jetable, JAMAIS la base de production.
# Facultatif pour le développement ; requis avant la mise en production.
DATABASE_URL_TEST=""

# Auth.js : générer avec `npx auth secret`
AUTH_SECRET=""

# Application Discord (discord.com/developers → OAuth2)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Bot Discord : annonce de première liaison dans le salon choisi (facultatif).
# Jeton du bot, différent du secret OAuth ; voir docs/DISCORD.md.
DISCORD_BOT_TOKEN=""
DISCORD_LINK_CHANNEL_ID=""

# Accueil, rôles, marché et saisons Discord (facultatifs ; voir docs/DISCORD.md).
# Public Key depuis General Information, différente du secret OAuth et du jeton du bot.
DISCORD_PUBLIC_KEY=""
DISCORD_GUILD_ID=""
DISCORD_RULES_CHANNEL_ID=""
DISCORD_MEMBER_ROLE_ID=""
DISCORD_MARKET_CHANNEL_ID=""
# Rôles de préférences : Marchand et Fighter activent des notifications, sans droit de gestion.
DISCORD_ROLES_CHANNEL_ID=""
DISCORD_MERCHANT_ROLE_ID=""
DISCORD_COLLECTOR_ROLE_ID=""
DISCORD_FIGHTER_ROLE_ID=""
# Rôle attribué uniquement aux comptes Kiraku réellement liés à Discord.
DISCORD_LINKED_ROLE_ID=""
# Salon des bilans de saison en PNG (le bot doit pouvoir joindre des fichiers).
DISCORD_RANKED_CHANNEL_ID=""
# Salon privé de l'équipe pour les incidents techniques du bot (facultatif).
DISCORD_ALERTS_CHANNEL_ID=""
# Salon des annonces du casino : teaser, ouverture et gros lancers (le bot doit pouvoir joindre des fichiers).
DISCORD_CASINO_CHANNEL_ID=""
# Salon des annonces du prestige : renaissances et éditions gravées tirées (facultatif).
DISCORD_PRESTIGE_CHANNEL_ID=""
# Salon privé de l'équipe : fil du parrainage v2, un message par versement, blocage et décision (facultatif).
DISCORD_REFERRAL_CHANNEL_ID=""
# Salon public des annonces : lancement du parrainage v2 et de l'Ennichi, publié depuis /admin/parrainage/annonce,
# avec @everyone (facultatif ; le bot doit pouvoir y mentionner @everyone).
DISCORD_ANNOUNCE_CHANNEL_ID=""
# Salon du guide ; utilisé par scripts/setup-discord-community.mts (facultatif).
DISCORD_GUIDE_CHANNEL_ID=""
# Rôles d'équipe sans droit de gestion, en plus de ceux du code, admis à lire les salons privés (#logs-bot, fil du
# parrainage) : « id,id » (facultatif).
DISCORD_STAFF_ROLE_IDS=""

# E-mails via Resend (facultatif : sans clé, aucun e-mail ne part ; en dev, liens dans les logs)
RESEND_API_KEY=""
# Expéditeur, sur un domaine vérifié chez Resend (DKIM, SPF) : « Kiraku <noreply@kiraku-kun.com> ».
# L'adresse de test @resend.dev ne livre qu'au propriétaire du compte Resend : aucun joueur ne reçoit rien.
# Sur le VPS, ces deux clés vont dans .env (pas .env.local, qui n'est pas copié dans la release), puis on redéploie.
MAIL_FROM=""
# Origine publique (liens des e-mails et d'invitation, images de partage, sitemap), sans barre finale.
# Obligatoire en production : sans elle, l'application refuse de démarrer.
APP_URL="https://kiraku-kun.com"
# Facultatif : « preview » pour une préproduction (robots.txt refuse tout). Par défaut, déduit de NODE_ENV.
APP_ENV=""

# Id Discord du premier administrateur
ADMIN_DISCORD_ID=""

# Web Push (facultatif : sans ces trois variables, l'option est masquée dans /compte)
# Générer la paire avec `npx web-push generate-vapid-keys` ; une paire par environnement.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact pour les services push : mailto:… ou https://…
VAPID_SUBJECT=""

# Tâches planifiées (/api/cron/*, appelées par la crontab du VPS avec « Authorization: Bearer … »).
# Au moins 16 caractères, générer avec `openssl rand -hex 32`. Obligatoire en production.
CRON_SECRET=""

# Ably (temps réel du combat) : ably.com → app → API Keys, droits publish + subscribe.
# Facultatif : sans clé, le plateau de combat sonde la partie toutes les 2 s.
ABLY_API_KEY=""

# Images des cartes et des nouveautés envoyées depuis l'admin : un stockage Vercel Blob PUBLIC (créé dans le
# tableau de bord Vercel, utilisable depuis le VPS). Son jeton, et le domaine exact (sans https://) du stockage.
BLOB_READ_WRITE_TOKEN=""
BLOB_PUBLIC_HOST=""

# Publicité Google AdSense : « 1 » charge le script des annonces et du message de consentement.
# À n'allumer qu'une fois le message « Confidentialité et messages » publié dans AdSense.
# La balise meta et public/ads.txt (validation du site) sont présentes dans tous les cas.
ADS_ENABLED=""
