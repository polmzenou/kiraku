# Copie ce fichier en .env.local et remplis les valeurs (jamais de NEXT_PUBLIC_).

# Supabase (Connect → ORMs) : pooler en mode transaction (6543) pour l'appli, mode session (5432)
# pour les migrations. Pas l'hôte direct db.<ref>.supabase.co : IPv6 seulement, injoignable depuis Vercel.
DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Tests d'intégration : base isolée (autre projet ou branche Supabase), JAMAIS la base de production.
# Facultatif pour le développement ; requis avant la mise en production.
DATABASE_URL_TEST=""

# Auth.js : générer avec `npx auth secret`
AUTH_SECRET=""

# Application Discord (discord.com/developers → OAuth2)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Bot Discord : annonce de première liaison dans le salon choisi (facultatif).
# Jeton du bot, différent du secret OAuth ; voir docs/DISCORD.md.
DISCORD_BOT_TOKEN=""
DISCORD_LINK_CHANNEL_ID=""

# Accueil et marché Discord (facultatifs ; voir docs/DISCORD.md).
# Public Key depuis General Information, différente du secret OAuth et du jeton du bot.
DISCORD_PUBLIC_KEY=""
DISCORD_GUILD_ID=""
DISCORD_RULES_CHANNEL_ID=""
DISCORD_MEMBER_ROLE_ID=""
DISCORD_MARKET_CHANNEL_ID=""

# E-mails via Resend (facultatif : sans clé, aucun e-mail ne part ; en dev, liens dans les logs)
RESEND_API_KEY=""
# Expéditeur : « Kiraku <onboarding@resend.dev> » tant qu'aucun domaine n'est vérifié
MAIL_FROM=""
# Origine publique (liens des e-mails et d'invitation, images de partage, sitemap), sans barre finale.
# Obligatoire en production : sans elle, l'application refuse de démarrer.
APP_URL="https://kiraku-kun.com"
# Facultatif : « preview » pour une préproduction (robots.txt refuse tout). Par défaut, déduit de NODE_ENV.
APP_ENV=""

# Id Discord du premier administrateur
ADMIN_DISCORD_ID=""

# Web Push (facultatif : sans ces trois variables, l'option est masquée dans /compte)
# Générer la paire avec `npx web-push generate-vapid-keys` ; une paire par environnement.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact pour les services push : mailto:… ou https://…
VAPID_SUBJECT=""

# Tâches planifiées (/api/cron/*, appelées par la crontab du VPS avec « Authorization: Bearer … »).
# Au moins 16 caractères, générer avec `openssl rand -hex 32`. Obligatoire en production.
CRON_SECRET=""

# Ably (temps réel du combat) : ably.com → app → API Keys, droits publish + subscribe.
# Facultatif : sans clé, le plateau de combat sonde la partie toutes les 2 s.
ABLY_API_KEY=""

# Images des cartes créées dans l'admin : connecter un Vercel Blob PUBLIC au projet.
# Copier le jeton en local, et le domaine exact (sans https://) du stockage.
BLOB_READ_WRITE_TOKEN=""
BLOB_PUBLIC_HOST=""

# Publicité Google AdSense : « 1 » charge le script des annonces et du message de consentement.
# À n'allumer qu'une fois le message « Confidentialité et messages » publié dans AdSense.
# La balise meta et public/ads.txt (validation du site) sont présentes dans tous les cas.
ADS_ENABLED=""
