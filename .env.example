# Copie ce fichier en .env.local et remplis les valeurs (jamais de NEXT_PUBLIC_).

# Neon : URL poolée (hôte en -pooler) pour l'appli, URL directe pour les migrations
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/kiraku?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/kiraku?sslmode=require"

# Auth.js : générer avec `npx auth secret`
AUTH_SECRET=""

# Application Discord (discord.com/developers → OAuth2)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Upstash Redis (facultatif en local, obligatoire en production)
# Via l'intégration Vercel, KV_REST_API_URL / KV_REST_API_TOKEN sont aussi acceptés
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# E-mails via Resend (facultatif : sans clé, aucun e-mail ne part ; en dev, liens dans les logs)
RESEND_API_KEY=""
# Expéditeur : « Kiraku <onboarding@resend.dev> » tant qu'aucun domaine n'est vérifié
MAIL_FROM=""
# Origine publique pour les liens des e-mails (ex. https://kiraku.vercel.app)
APP_URL=""

# Id Discord du premier administrateur
ADMIN_DISCORD_ID=""

# Web Push (facultatif : sans ces trois variables, l'option est masquée dans /compte)
# Générer la paire avec `npx web-push generate-vapid-keys` ; une paire par environnement.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact pour les services push : mailto:… ou https://…
VAPID_SUBJECT=""
