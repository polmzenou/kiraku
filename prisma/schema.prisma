// Schéma du socle (étape 1), du catalogue (étape 2), des boosters (étape 3), de leurs types (étape 4),
// de la collection et du profil (étape 5), du social (étape 6), de l'économie (étape 7), de l'hôtel des ventes (étape 8)
// et du combat (étape 9).
// Chaque étape ajoute ses modèles
// par sa propre migration nommée. Référence : docs/PLAN.md, « Schéma Prisma ».

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CoinReason {
  SIGNUP
  BID_HOLD
  BID_REFUND
  SALE
  FEE
  DISSOLVE
  BATTLE_WIN
  DAILY
  MISSION
  REFERRAL
  ADMIN
  SHOP
  DISCORD_LINK
  BOOSTER // achat d'un booster en Zeni
  GIFT // booster offert à un ami
}

// Qui voit le profil public (/u/[username]) ; FRIENDS = amis acceptés seulement
enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  email               String?           @unique
  emailVerified       DateTime? // requis par Auth.js
  passwordHash        String? // argon2id, compte e-mail + mot de passe
  discordLinkedAt     DateTime? // première liaison Discord (bonus versé une seule fois)
  image               String?
  // Valeurs de départ lues dans GameSetting à la création (jamais en dur)
  coins               Int               @default(0) // solde en Zeni
  boosterStock        Int               @default(0)
  boosterAnchor       DateTime          @default(now()) // début du cycle de booster en cours
  rankPoints          Int               @default(0) // points de classement (mode classé)
  battleTeam          String[] // ids de Card de la dernière équipe de combat (pré-remplie au prochain combat)
  role                Role              @default(USER)
  bannedAt            DateTime?
  isGuest             Boolean           @default(true)
  pityCount           Int               @default(0) // boosters ouverts depuis la dernière Mythique
  standardCount       Int               @default(0) // pour le booster doré
  bannerPity          Json              @default("{}") // { boosterTypeId: boosters sans vedette }
  discordJoinedAt     DateTime? // a cliqué sur « Rejoindre le serveur »
  locale              String            @default("fr") // fr | en
  birthDate           DateTime? // contrôle d'âge
  termsVersion        Int? // version des CGU acceptée
  deletionRequestedAt DateTime? // suppression RGPD en attente
  // Code de parrainage court (8 caractères sans 0/O/1/I), généré par la base
  referralCode        String            @unique @default(dbgenerated("kiraku_referral_code()"))
  referredById        String? // parrain, posé au rattachement (Referral fait foi)
  profileVisibility   ProfileVisibility @default(PUBLIC) // invités créés en PRIVATE
  showCollection      Boolean           @default(true) // collection complète visible sur le profil
  privacyChosenAt     DateTime? // réglé par le joueur : l'inscription ne le change plus
  createdAt           DateTime          @default(now())

  accounts    Account[]
  sessions    Session[]
  ledger      CoinTransaction[]
  authTokens  AuthToken[]
  cards       UserCard[]
  openings    BoosterOpening[]
  discoveries Discovery[]
  adminLogs   AdminLog[]
  showcase    ShowcaseSlot[]
  wishlist    WishlistEntry[]

  sentFriends   Friendship[]       @relation("requester")
  recvFriends   Friendship[]       @relation("addressee")
  blocking      UserBlock[]        @relation("blocker")
  blockedBy     UserBlock[]        @relation("blocked")
  giftsSent     Gift[]             @relation("giftSender")
  giftsReceived Gift[]             @relation("giftRecipient")
  notifications Notification[]     @relation("notified")
  notified      Notification[]     @relation("notifActor")
  pushSubs      PushSubscription[]

  boosterCredits BoosterCredit[]
  missions       UserMission[]
  purchases      Purchase[]
  referralsMade  Referral[]      @relation("referrer")
  referral       Referral?       @relation("referee")

  auctions    Auction[] @relation("seller")
  leadingBids Auction[] @relation("leader")
  bids        Bid[]

  review      Review?
  battlesAsP1 Battle[]     @relation("battleP1")
  battlesAsP2 Battle[]     @relation("battleP2")
  battleQueue BattleQueue?

  @@index([rankPoints])
}

// --- Auth.js ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Jetons à usage unique envoyés par e-mail (seul leur hash SHA-256 est stocké)
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// --- Réglages et économie ---

model GameSetting {
  key       String   @id // ex. booster.intervalMinutes, ranked.tiers
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Journal de l'économie : toute écriture sur User.coins passe par server/economy/ledger.ts
model CoinTransaction {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  amount       Int // + crédit, - débit
  reason       CoinReason
  refId        String? // id d'enchère, de combat…
  balanceAfter Int? // solde juste après l'écriture (null pour les lignes d'avant l'étape 7)
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt, id]) // historique par curseur
}

// --- Catalogue (étape 2) ---

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

enum CatalogImportStatus {
  RUNNING
  FINALIZED
  ABANDONED
  FAILED
}

// Œuvre principale d'un personnage sur AniList (champs de filtre des boosters)
model Series {
  id           String   @id @default(cuid())
  anilistId    Int      @unique
  type         String // ANIME | MANGA
  titleRomaji  String
  titleEnglish String? // affiché en anglais quand il existe
  titleNative  String?
  isAdult      Boolean  @default(false)
  genres       String[]
  tags         String[] // tags de rang ≥ catalog.minTagRank
  year         Int?
  season       String? // WINTER | SPRING | SUMMER | FALL
  seasonYear   Int?
  studio       String? // studio principal
  cards        Card[]
}

// Le personnage (le modèle de carte) ; l'exemplaire possédé sera UserCard
model Card {
  id            String      @id @default(cuid())
  anilistId     Int         @unique // id du personnage AniList = /wiki/[anilistId]
  name          String
  nameNative    String? // nom japonais, écrit verticalement sur la fuda
  imageUrl      String
  favorites     Int // favoris AniList au dernier import
  rank          Int?        @unique // 1 = le plus populaire ; null = sorti du catalogue
  rarity        Rarity
  power         Int // 力 attaque en combat
  ki            Int // 気 défense ; HP et vitesse sont dérivés
  seriesId      String
  series        Series      @relation(fields: [seriesId], references: [id])
  gender        String? // Female | Male | … (AniList, souvent vide)
  birthMonth    Int?
  birthDay      Int?
  role          String? // MAIN | SUPPORTING | BACKGROUND dans l'œuvre principale
  searchText    String // nom, nom natif et titres, en minuscules sans accents
  addedImportId String? // import qui a fait entrer la carte (nouveautés)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  copies        UserCard[]
  discoveries   Discovery[]
  lotItems      LotItem[]
  auctions      Auction[]
  wishedBy      WishlistEntry[]

  @@index([rarity, rank])
  @@index([seriesId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Une exécution de l'import AniList, reprenable après interruption
model CatalogImport {
  id         String              @id @default(cuid())
  status     CatalogImportStatus @default(RUNNING)
  target     Int // nombre de personnages visés
  lastPage   Int                 @default(0) // reprise à lastPage + 1
  kept       Int                 @default(0) // personnages valides en staging
  startedAt  DateTime            @default(now())
  finishedAt DateTime?
  error      String?
  rows       CatalogImportRow[]

  @@index([status, startedAt])
}

// Personnages récupérés, normalisés, en attente de finalisation
model CatalogImportRow {
  importId  String
  import    CatalogImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  anilistId Int
  position  Int // ordre renvoyé par AniList (départage les égalités)
  favorites Int
  data      Json // ImportedCharacter (lib/catalog/anilist.ts)

  @@id([importId, anilistId])
}

// --- Boosters (étape 3) ---

enum CardStatus {
  COLLECTION
  AUCTION
  BATTLE
}

// Exemplaire possédé d'une carte : c'est lui qui se vend, se met en vitrine et combat
model UserCard {
  id         String        @id @default(cuid())
  ownerId    String
  owner      User          @relation(fields: [ownerId], references: [id])
  cardId     String
  card       Card          @relation(fields: [cardId], references: [id])
  status     CardStatus    @default(COLLECTION)
  obtainedAt DateTime      @default(now())
  showcase   ShowcaseSlot?
  auctions   Auction[]

  @@index([ownerId, cardId])
  @@index([ownerId, status, cardId]) // collection groupée par carte (couvre aussi [ownerId, status])
}

// Un booster ouvert, partageable par lien (/tirage/[id])
model BoosterOpening {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  boosterSlug    String // BoosterType.slug
  cardIds        String[] // ids de UserCard, dans l'ordre des emplacements
  catalogCardIds String[] // ids de Card dans le même ordre : le tirage reste lisible après recyclage ou vente
  golden         Boolean  @default(false)
  divine         Boolean  @default(false)
  pityTriggered  Boolean  @default(false) // dernière carte forcée en Mythique
  featuredHit    Boolean  @default(false) // au moins une carte vedette (bannière)
  zeniSpent      Int      @default(0) // prix payé pour ce booster (0 = stock gratuit)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// Carte déjà obtenue au moins une fois (badge « Nouveau », fiche wiki), même si elle a été revendue
model Discovery {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, cardId])
  @@index([userId, createdAt]) // missions « découvrir des cartes »
}

// Journal de toutes les écritures faites depuis /admin
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String // ex. SETTING_UPDATE, ROLE_GRANT
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// --- Types de boosters (étape 4) ---

enum BoosterKind {
  STANDARD
  RARITY
  FILTERED
  BANNER
  FORMAT
}

enum BoosterShape {
  SACHET
  POCHIBUKURO
  JUBAKO
}

// Un booster proposé : filtre sur le catalogue, planchers, prix. Réglé dans /admin, chargé par seed.
model BoosterType {
  id              String          @id @default(cuid())
  slug            String          @unique
  kind            BoosterKind
  family          String // standard | formats | rarete | demographie | genre | personnage | epoque | special
  sortOrder       Int             @default(0)
  name            Json // { fr, en } (repli sur fr)
  tagline         Json // { fr, en }
  emblem          String // kanji de l'étiquette
  shape           BoosterShape    @default(SACHET)
  theme           Json // { base, dark, pattern, ink } (lib/boosters/types.ts)
  filter          Json            @default("{}") // PoolFilter (lib/boosters/pool-filter.ts)
  slotFloors      String[] // vide = réglage global booster.slotFloors
  usesFreeStock   Boolean         @default(true)
  priceZeni       Int? // prix en Zeni (payant, ou quand le stock gratuit est vide) ; null = pas d'achat
  countsForPity   Boolean         @default(true) // pitié Mythique partagée
  bonusEligible   Boolean         @default(true) // sachets doré et divin
  featuredCardIds String[] // cartes vedettes (bannière)
  featuredRate    Int             @default(5000) // points de base : part des tirages d'une rareté qui va aux vedettes
  featuredPity    Int             @default(100) // vedette garantie au N-ième booster sans vedette
  minPoolSize     Int? // sinon GameSetting booster.minPool
  poolCardIds     String[] // recalculé après import, seed ou modification admin
  poolCounts      Json? // { COMMON: n, … }
  poolComputedAt  DateTime?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  credits         BoosterCredit[]
  lotItems        LotItem[]

  @@index([family, sortOrder])
}

// --- Collection et profil (étape 5) ---

// Vitrine du profil : positions 1 à showcase.slots ; un exemplaire n'occupe qu'un emplacement
model ShowcaseSlot {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Int
  userCardId String   @unique
  userCard   UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@id([userId, position])
}

// Une carte souhaitée n'a pas besoin d'être possédée. Vingt positions au maximum par profil.
model WishlistEntry {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now())

  @@id([userId, cardId])
  @@unique([userId, position])
  @@index([cardId])
}

// --- Social (étape 6) ---

enum FriendStatus {
  PENDING
  ACCEPTED
}

// Une seule ligne par paire de joueurs, quel que soit le sens de la demande (pairKey = ids triés)
model Friendship {
  id          String       @id @default(cuid())
  pairKey     String       @unique
  requesterId String
  requester   User         @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  // Refus silencieux : l'expéditeur voit toujours « Demande envoyée », le destinataire ne la voit plus
  declinedAt  DateTime?

  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// Blocage à sens unique ; aucun des deux ne peut plus demander, offrir ni notifier l'autre
model UserBlock {
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Après un refus ou une annulation : pas de nouvelle demande entre ces deux joueurs avant `until`
model FriendRequestCooldown {
  pairKey String   @id
  until   DateTime
}

enum GiftKind {
  CARD
  BOOSTER
}

// Journal des cadeaux : quotas du jour et historique des cartes transférées
model Gift {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("giftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("giftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind        GiftKind
  cardId      String? // id de Card : reste lisible après recyclage ou revente
  userCardId  String? // exemplaire transféré
  zeniSpent   Int      @default(0)
  dayKey      String // jour du fuseau game.timeZone (AAAA-MM-JJ)
  createdAt   DateTime @default(now())

  @@index([senderId, dayKey])
  @@index([senderId, createdAt]) // missions hebdomadaires
  @@index([recipientId, dayKey])
  @@index([createdAt])
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GIFT_RECEIVED
  REFERRAL_QUALIFIED
  OUTBID // quelqu'un a surenchéri : la mise est rendue
  AUCTION_WON
  AUCTION_SOLD
  AUCTION_EXPIRED // aucune mise, la carte revient au vendeur
  AUCTION_CANCELLED // annulée par l'admin, mise rendue
  BATTLE_INVITE // un ami t'invite en combat avec un code
}

// Notifications en base ; le texte est rendu à la lecture (pseudo à jour, langue du lecteur)
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("notified", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String?
  actor     User?            @relation("notifActor", fields: [actorId], references: [id], onDelete: Cascade)
  refId     String? // id de Friendship, de Gift…
  payload   Json             @default("{}") // ids et nombres uniquement, jamais de texte libre
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Abonnements Web Push (un par navigateur). L'endpoint est l'adresse du service push du
// navigateur : unique, un autre compte qui s'abonne depuis le même navigateur le reprend.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String // clé publique du navigateur (base64url)
  auth       String // secret d'authentification (base64url)
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// --- Économie (étape 7) ---

// Boosters à ouvrir, par type : cadeaux d'amis, boutique, missions, parrainage. Ouverts comme un
// cadeau : pitié Mythique comptée, sans booster doré ni divin.
model BoosterCredit {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boosterTypeId String
  boosterType   BoosterType @relation(fields: [boosterTypeId], references: [id])
  count         Int         @default(0) // CHECK (count >= 0) dans la migration
  updatedAt     DateTime    @updatedAt

  @@id([userId, boosterTypeId])
}

enum LotItemKind {
  BOOSTER // `quantity` boosters du type boosterTypeId
  CARD // `quantity` exemplaires de la carte cardId
  RARITY_CARD // `quantity` cartes tirées dans la rareté, pool du booster standard
}

// Récompense réutilisable (missions, parrainage, boutique)
model Lot {
  id        String     @id @default(cuid())
  name      Json // { fr, en }
  zeni      Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     LotItem[]
  missions  Mission[]
  shopItems ShopItem[]
}

model LotItem {
  id            String       @id @default(cuid())
  lotId         String
  lot           Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  kind          LotItemKind
  boosterTypeId String?
  boosterType   BoosterType? @relation(fields: [boosterTypeId], references: [id])
  cardId        String?
  card          Card?        @relation(fields: [cardId], references: [id])
  rarity        Rarity?
  quantity      Int          @default(1)

  @@index([lotId])
}

enum MissionPeriod {
  DAILY
  WEEKLY
}

// Ce que compte une mission ; la progression est dérivée des journaux existants (pas de compteur)
enum MissionMetric {
  VISIT // passer sur le jeu (toujours accomplie)
  OPEN_BOOSTERS
  PULL_RARITY // cartes de rareté ≥ Mission.rarity tirées en booster
  DISCOVER_CARDS
  RECYCLE_ZENI // Zeni gagnés en recyclant
  SPEND_ZENI
  SEND_GIFTS
  ADD_FRIENDS
}

model Mission {
  id        String        @id @default(cuid())
  key       String        @unique // ex. daily-open-5
  period    MissionPeriod
  metric    MissionMetric
  goal      Int
  rarity    Rarity? // PULL_RARITY seulement
  title     Json? // { fr, en } ; absent = texte généré depuis metric et goal
  lotId     String
  lot       Lot           @relation(fields: [lotId], references: [id])
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  claims    UserMission[]

  @@index([active, period, sortOrder])
}

// Une ligne = une récompense réclamée ; la clé primaire rend la double réclamation impossible
model UserMission {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])
  periodKey String // 2026-10-14 ou 2026-W42 (fuseau game.timeZone)
  claimedAt DateTime @default(now())

  @@id([userId, missionId, periodKey])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REVOKED
}

// Un filleul n'a qu'un parrain ; les récompenses ne sont versées qu'à la qualification
model Referral {
  id                String         @id @default(cuid())
  referrerId        String
  referrer          User           @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId         String         @unique
  referee           User           @relation("referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status            ReferralStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  qualifiedAt       DateTime?
  referrerClaimedAt DateTime?
  refereeClaimedAt  DateTime?

  @@index([referrerId, createdAt])
  @@index([createdAt])
}

enum ShopLimitPeriod {
  ONCE
  DAILY
  WEEKLY
}

// Article de la boutique : livre un lot. Les champs en euros restent inertes tant qu'aucun
// fournisseur de paiement n'est branché (server/payments).
model ShopItem {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          Json // { fr, en }
  description   Json // { fr, en }
  lotId         String
  lot           Lot              @relation(fields: [lotId], references: [id])
  priceZeni     Int? // null = pas d'achat en Zeni
  priceCents    Int? // prix en euros (paiement par carte, plus tard)
  stripePriceId String?
  perUserLimit  Int? // null = sans limite
  limitPeriod   ShopLimitPeriod?
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  purchases     Purchase[]

  @@index([active, sortOrder])
}

enum PurchaseCurrency {
  ZENI
  EUR
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Purchase {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItemId  String
  shopItem    ShopItem         @relation(fields: [shopItemId], references: [id])
  currency    PurchaseCurrency
  amount      Int // Zeni ou centimes
  status      PurchaseStatus   @default(PENDING)
  provider    String? // fournisseur de paiement (EUR)
  providerRef String?          @unique // id de session ou de paiement chez le fournisseur
  periodKey   String // fenêtre de la limite d'achat : « all », jour ou semaine
  createdAt   DateTime         @default(now())
  paidAt      DateTime?

  @@index([userId, shopItemId, periodKey])
  @@index([createdAt])
}

// --- Hôtel des ventes (étape 8) ---

enum AuctionStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

// Une vente aux enchères en Zeni. La carte est réservée (UserCard.status = AUCTION) et la mise en
// tête est en séquestre : déjà débitée du meneur (BID_HOLD), rendue s'il est dépassé (BID_REFUND).
// Invariant : Σ soldes + Σ currentBid des ventes ACTIVE + Σ taxes (FEE) ne bouge pas.
// Dans la migration : une seule vente ACTIVE par exemplaire (index unique partiel) et CHECK sur les prix.
model Auction {
  id              String        @id @default(cuid())
  sellerId        String
  seller          User          @relation("seller", fields: [sellerId], references: [id])
  userCardId      String? // null si l'exemplaire a été recyclé après la vente
  userCard        UserCard?     @relation(fields: [userCardId], references: [id], onDelete: SetNull)
  cardId          String // la carte du catalogue : historique et filtres
  card            Card          @relation(fields: [cardId], references: [id])
  startPrice      Int
  buyoutPrice     Int? // achat immédiat ; proposé tant qu'aucune mise ne l'atteint
  currentBid      Int? // mise en tête, en séquestre
  currentBidderId String?
  currentBidder   User?         @relation("leader", fields: [currentBidderId], references: [id], onDelete: Restrict) // une mise en séquestre ne perd jamais son propriétaire
  price           Int // currentBid ?? startPrice, pour trier et filtrer
  bidCount        Int           @default(0)
  feeBp           Int // taxe figée à la mise en vente (points de base)
  endsAt          DateTime // repoussée par l'anti-sniping
  status          AuctionStatus @default(ACTIVE)
  finalPrice      Int?
  fee             Int?
  settledAt       DateTime?
  cancelledAt     DateTime?
  cancelledById   String? // vendeur ou admin
  createdAt       DateTime      @default(now())
  bids            Bid[]

  @@index([status, endsAt, id]) // balayage de clôture et tri « finit bientôt »
  @@index([status, price, id])
  @@index([status, createdAt, id])
  @@index([sellerId, status])
  @@index([currentBidderId, status])
  @@index([cardId, status])
}

// Journal immuable des mises acceptées
model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id])
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
  @@index([bidderId, createdAt])
}

// Avis public d'un joueur (note + texte brut) : un par joueur, modifiable ; masqué par la modération
model Review {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1 à 5, contrôlé par Zod et par une contrainte CHECK
  body      String // 1 000 caractères max, texte brut
  hidden    Boolean   @default(false)
  pinned    Boolean   @default(false) // en tête du carrousel de l'accueil ; jamais avec hidden (CHECK)
  pinnedAt  DateTime?
  reply     String? // réponse de l'équipe, texte brut, 1 000 caractères max (CHECK)
  repliedAt DateTime?
  // Les écritures de la modération passent par du SQL brut : elles ne touchent pas updatedAt,
  // qui reste la date de l'avis du joueur
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([hidden, updatedAt])
}

// --- Combat 1v1 en direct (étape 9) ---

enum BattleMode {
  FRIEND // salle privée avec un code, non classée
  EXHIBITION // file d'attente, non classée
  RANKED // file d'attente classée (étape 9b)
}

enum BattleStatus {
  WAITING // salle d'amis ouverte, en attente du second joueur
  ACTIVE
  FINISHED
  CANCELLED // salle expirée ou fermée avant le début
}

enum BattleEndReason {
  KO
  FORFEIT
  TIMEOUT // trop de tours expirés d'affilée
  TURN_LIMIT
}

// Une partie : setup figé + graine + actions (BattleAction) suffisent à la rejouer à l'identique.
// state est le cache de l'état courant ; version sert à la concurrence optimiste.
model Battle {
  id            String           @id @default(cuid())
  mode          BattleMode
  status        BattleStatus     @default(WAITING)
  code          String?          @unique // code ami tant que la salle attend
  codeExpiresAt DateTime?
  seed          Int // 0 ≤ seed < 2^31, tirée par le serveur
  p1Id          String
  p1            User             @relation("battleP1", fields: [p1Id], references: [id], onDelete: Cascade)
  p2Id          String? // null = bot
  p2            User?            @relation("battleP2", fields: [p2Id], references: [id], onDelete: Cascade)
  botName       String? // nom du bot affiché (lib/battle/bot.ts)
  p1Team        String[] // ids de UserCard (vides pour le bot)
  p2Team        String[]
  setup         Json? // BattleSetup (lib/battle/types.ts), posé au lancement
  state         Json? // BattleState courant
  version       Int              @default(0)
  turnEndsAt    DateTime?
  winnerSide    Int? // 0 = p1, 1 = p2, null = nul ou en cours
  endReason     BattleEndReason?
  rewardZeni    Int              @default(0) // versés au gagnant
  createdAt     DateTime         @default(now())
  startedAt     DateTime?
  endedAt       DateTime?
  actions       BattleAction[]

  @@index([p1Id, createdAt])
  @@index([p2Id, createdAt])
  @@index([status, turnEndsAt])
}

// Journal des actions d'une partie, dans l'ordre (seq = BattleState.seq avant l'action)
model BattleAction {
  battleId  String
  battle    Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  seq       Int
  side      Int
  payload   Json // Action (lib/battle/types.ts)
  createdAt DateTime @default(now())

  @@id([battleId, seq])
}

// File d'attente : l'équipe est déjà bloquée (UserCard en BATTLE) ; seenAt prouve que le joueur attend encore
model BattleQueue {
  userId     String     @id
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       BattleMode
  rankPoints Int
  team       String[] // ids de UserCard
  joinedAt   DateTime   @default(now())
  seenAt     DateTime   @default(now())

  @@index([mode, joinedAt])
}
