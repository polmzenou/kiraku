// Schéma du socle (étape 1), du catalogue (étape 2), des boosters (étape 3), de leurs types (étape 4),
// de la collection et du profil (étape 5), du social (étape 6), de l'économie (étape 7), de l'hôtel des ventes (étape 8)
// du combat (étape 9) et de la conformité (étape 10).
// Chaque étape ajoute ses modèles
// par sa propre migration nommée. Référence : docs/PLAN.md, « Schéma Prisma ».

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CoinReason {
  SIGNUP
  BID_HOLD
  BID_REFUND
  SALE
  FEE
  DISSOLVE
  BATTLE_WIN
  DAILY
  MISSION
  REFERRAL
  ADMIN
  SHOP
  DISCORD_LINK
  BOOSTER // achat d'un booster en Zeni
  GIFT // booster offert à un ami
  SEASON // récompense de fin de saison du classé
}

// Qui voit le profil public (/u/[username]) ; FRIENDS = amis acceptés seulement
enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id                  String            @id @default(cuid())
  username            String            @unique
  email               String?           @unique
  emailVerified       DateTime? // requis par Auth.js
  passwordHash        String? // argon2id, compte e-mail + mot de passe
  discordLinkedAt     DateTime? // première liaison Discord (bonus versé une seule fois)
  image               String?
  // Valeurs de départ lues dans GameSetting à la création (jamais en dur)
  coins               Int               @default(0) // solde en Zeni
  boosterStock        Int               @default(0)
  boosterAnchor       DateTime          @default(now()) // début du cycle de booster en cours
  rankPoints          Int               @default(0) // points de classement (mode classé)
  battleTeam          String[] // ids de Card de la dernière équipe de combat (pré-remplie au prochain combat)
  // Classé (étape 9b) : protection après une montée de rang, meilleur rang de la saison
  rankProtection      Int               @default(0) // parties classées encore protégées
  seasonPeakPc        Int               @default(0)
  seasonPeakGrand     Boolean           @default(false) // a été Grand Champion cette saison
  seasonGames         Int               @default(0)
  role                Role              @default(USER)
  bannedAt            DateTime?
  pullFeedHiddenUntil DateTime? // modération : retiré du carrousel des gros tirages jusqu'à cette date
  isGuest             Boolean           @default(true)
  pityCount           Int               @default(0) // boosters ouverts depuis la dernière Mythique
  standardCount       Int               @default(0) // pour le booster doré
  bannerPity          Json              @default("{}") // { boosterTypeId: boosters sans vedette }
  apocalypseKarma     Int               @default(0) // Apocalyptiques ruinés d'affilée (CHECK >= 0) : au seuil, le suivant est épargné
  discordJoinedAt     DateTime? // a cliqué sur « Rejoindre le serveur »
  v1WelcomeSeenAt     DateTime? // date de la dernière annonce de l'équipe vue (une fois par annonce, lib/welcome/release.ts)
  locale              String            @default("fr") // fr | en
  birthDate           DateTime? // inutilisé : pas de contrôle d'âge (décision de l'étape 10)
  termsVersion        Int? // version des CGU acceptée
  deletionRequestedAt DateTime? // suppression RGPD en attente : compte gelé jusqu'à l'anonymisation
  anonymizedAt        DateTime? // compte anonymisé (RGPD) : plus aucune donnée personnelle
  usernameChangedAt   DateTime? // dernier changement de pseudo par le joueur (délai account.usernameChangeDays)
  // Code de parrainage court (8 caractères sans 0/O/1/I), généré par la base
  referralCode        String            @unique @default(dbgenerated("kiraku_referral_code()"))
  referredById        String? // parrain, posé au rattachement (Referral fait foi)
  profileVisibility   ProfileVisibility @default(PUBLIC) // invités créés en PRIVATE
  showCollection      Boolean           @default(true) // collection complète visible sur le profil
  privacyChosenAt     DateTime? // réglé par le joueur : l'inscription ne le change plus
  // Personnalisation du profil (étape 12h) : bio, accord des titres, titre et cadre débloqués, ordre des badges
  bio                 String?           @db.VarChar(160)
  titleAgreement      TitleAgreement    @default(MASC)
  titleId             String?
  title               Cosmetic?         @relation("userTitle", fields: [titleId], references: [id], onDelete: SetNull)
  frameId             String?
  frame               Cosmetic?         @relation("userFrame", fields: [frameId], references: [id], onDelete: SetNull)
  nameColorId         String? // couleur du pseudo (Cosmetic NAME_COLOR)
  nameColor           Cosmetic?         @relation("userNameColor", fields: [nameColorId], references: [id], onDelete: SetNull)
  badgeOrder          String[]          @default([])
  createdAt           DateTime          @default(now())

  accounts     Account[]
  sessions     Session[]
  ledger       CoinTransaction[]
  authTokens   AuthToken[]
  cards        UserCard[]
  openings     BoosterOpening[]
  notablePulls NotablePull[]
  discoveries  Discovery[]
  adminLogs    AdminLog[]
  showcase     ShowcaseSlot[]
  wishlist     WishlistEntry[]

  sentFriends   Friendship[]       @relation("requester")
  recvFriends   Friendship[]       @relation("addressee")
  blocking      UserBlock[]        @relation("blocker")
  blockedBy     UserBlock[]        @relation("blocked")
  giftsSent     Gift[]             @relation("giftSender")
  giftsReceived Gift[]             @relation("giftRecipient")
  notifications Notification[]     @relation("notified")
  notified      Notification[]     @relation("notifActor")
  pushSubs      PushSubscription[]

  boosterCredits BoosterCredit[]
  sealedDrops    SealedDrop[]    @relation("sealedOwner")
  sealedGiven    SealedDrop[]    @relation("sealedGiver")
  missions       UserMission[]
  purchases      Purchase[]
  referralsMade  Referral[]      @relation("referrer")
  referral       Referral?       @relation("referee")

  auctions    Auction[] @relation("seller")
  leadingBids Auction[] @relation("leader")
  bids        Bid[]

  review        Review?
  battlesAsP1   Battle[]       @relation("battleP1")
  battlesAsP2   Battle[]       @relation("battleP2")
  battleQueue   BattleQueue?
  seasonResults SeasonResult[]

  dataRequests       DataRequest[]  @relation("dataRequester")
  processedRequests  DataRequest[]  @relation("dataProcessor")
  publishedLegalDocs LegalPage[]
  lotGrants          LotGrant[]     @relation("lotGrantee")
  lotGrantsGiven     LotGrant[]     @relation("lotGranter")
  lotBroadcasts      LotBroadcast[]
  teamGifts          TeamGift[]

  tradesProposed Trade[]        @relation("tradeProposer")
  tradesReceived Trade[]        @relation("tradeRecipient")
  tradeListings  TradeListing[]
  listingOffers  ListingOffer[]
  chatSent       ChatMessage[]  @relation("chatSender")
  chatReceived   ChatMessage[]  @relation("chatRecipient")

  @@index([rankPoints])
}

// --- Auth.js ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Jetons à usage unique envoyés par e-mail (seul leur hash SHA-256 est stocké)
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// --- Réglages et économie ---

model GameSetting {
  key       String   @id // ex. booster.intervalMinutes, ranked.tiers
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// Journal de l'économie : toute écriture sur User.coins passe par server/economy/ledger.ts
model CoinTransaction {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int // + crédit, - débit
  reason       CoinReason
  refId        String? // id d'enchère, de combat…
  balanceAfter Int? // solde juste après l'écriture (null pour les lignes d'avant l'étape 7)
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt, id]) // historique par curseur
}

// --- Catalogue (étape 2) ---

// Compatibilité avec les versions déjà déployées : les anciennes colonnes restent en place.
enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

model RarityDefinition {
  key             String        @id
  nameFr          String
  nameEn          String
  sortOrder       Int
  seal            String
  appearance      Json          @default("{}")
  legacyBase      Rarity        @default(COMMON)
  /// Les cartes de cette rareté sont des variantes (AR, Gold) : carte de base et image propre obligatoires.
  variantRequired Boolean       @default(false)
  updatedAt       DateTime      @updatedAt
  cards           Card[]
  notablePulls    NotablePull[]
  lotItems        LotItem[]
  missions        Mission[]
}

enum CatalogCardStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CatalogImportStatus {
  RUNNING
  FINALIZED
  ABANDONED
  FAILED
}

// Œuvre principale d'un personnage sur AniList (champs de filtre des boosters)
model Series {
  id           String   @id @default(cuid())
  anilistId    Int?     @unique
  type         String // ANIME | MANGA
  titleRomaji  String
  titleEnglish String? // affiché en anglais quand il existe
  titleNative  String?
  isAdult      Boolean  @default(false)
  genres       String[]
  tags         String[] // tags de rang ≥ catalog.minTagRank
  year         Int?
  season       String? // WINTER | SPRING | SUMMER | FALL
  seasonYear   Int?
  studio       String? // studio principal
  cards        Card[]
}

// Le personnage (le modèle de carte) ; l'exemplaire possédé sera UserCard
model Card {
  id               String             @id @default(cuid())
  anilistId        Int?               @unique // source AniList uniquement
  publicId         Int                @unique @default(autoincrement())
  origin           String             @default("ANILIST")
  status           CatalogCardStatus  @default(PUBLISHED)
  description      Json               @default("{}")
  appearance       Json               @default("{}")
  dropWeight       Int                @default(1)
  adminOverrides   String[]           @default([])
  boosterIds       String[]           @default([]) // types explicitement sélectionnés pour les cartes manuelles
  name             String
  nameNative       String? // nom japonais, écrit verticalement sur la fuda
  imageUrl         String
  favorites        Int // favoris AniList au dernier import
  rank             Int?               @unique // 1 = le plus populaire ; null = sorti du catalogue
  rarity           String             @map("rarityKey")
  legacyRarity     Rarity             @default(COMMON) @map("rarity")
  rarityDefinition RarityDefinition   @relation(fields: [rarity], references: [key])
  power            Int // 力 attaque en combat
  ki               Int // 気 défense ; HP et vitesse sont dérivés
  seriesId         String
  series           Series             @relation(fields: [seriesId], references: [id])
  gender           String? // Female | Male | … (AniList, souvent vide)
  birthMonth       Int?
  birthDay         Int?
  role             String? // MAIN | SUPPORTING | BACKGROUND dans l'œuvre principale
  searchText       String // nom, nom natif et titres, en minuscules sans accents
  variantOfId      String? // carte de base d'une variante (forme alternative AR, version Gold)
  variantOf        Card?              @relation("cardVariants", fields: [variantOfId], references: [id], onDelete: Restrict)
  variants         Card[]             @relation("cardVariants")
  formName         String? // nom de la forme : « Gear 5 », « Bankai »
  addedImportId    String? // import qui a fait entrer la carte (nouveautés)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  copies           UserCard[]
  discoveries      Discovery[]
  lotItems         LotItem[]
  auctions         Auction[]
  wishedBy         WishlistEntry[]
  notablePulls     NotablePull[]
  tradesWanted     Trade[]            @relation("tradeWanted")
  tradesChosen     Trade[]            @relation("tradeChosen")
  tradeOffers      TradeOffer[]
  tradeListings    TradeListing[]
  listingWants     TradeListingWant[]
  listingOffers    ListingOffer[]

  @@index([rarity, rank], map: "Card_rarityKey_rank_idx")
  @@index([legacyRarity, rank], map: "Card_rarity_rank_idx")
  @@index([seriesId])
  @@index([status, origin])
  @@index([variantOfId])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Une exécution de l'import AniList, reprenable après interruption
model CatalogImport {
  id         String              @id @default(cuid())
  status     CatalogImportStatus @default(RUNNING)
  target     Int // nombre de personnages visés
  lastPage   Int                 @default(0) // reprise à lastPage + 1
  kept       Int                 @default(0) // personnages valides en staging
  startedAt  DateTime            @default(now())
  finishedAt DateTime?
  error      String?
  rows       CatalogImportRow[]

  @@index([status, startedAt])
}

// Personnages récupérés, normalisés, en attente de finalisation
model CatalogImportRow {
  importId  String
  import    CatalogImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  anilistId Int
  position  Int // ordre renvoyé par AniList (départage les égalités)
  favorites Int
  data      Json // ImportedCharacter (lib/catalog/anilist.ts)

  @@id([importId, anilistId])
}

// --- Boosters (étape 3) ---

enum CardStatus {
  COLLECTION
  AUCTION
  BATTLE
}

// Exemplaire possédé d'une carte : c'est lui qui se vend, se met en vitrine et combat
model UserCard {
  id         String        @id @default(cuid())
  ownerId    String
  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card          @relation(fields: [cardId], references: [id])
  status     CardStatus    @default(COLLECTION)
  obtainedAt DateTime      @default(now())
  showcase   ShowcaseSlot?
  auctions   Auction[]

  @@index([ownerId, cardId])
  @@index([ownerId, status, cardId]) // collection groupée par carte (couvre aussi [ownerId, status])
  @@index([cardId]) // exemplaires d'une carte (marché, échanges, fiche)
}

// Un booster ouvert, partageable par lien (/tirage/[id])
model BoosterOpening {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  boosterSlug    String // BoosterType.slug
  cardIds        String[] // ids de UserCard, dans l'ordre des emplacements
  catalogCardIds String[] // ids de Card dans le même ordre : le tirage reste lisible après recyclage ou vente
  golden         Boolean            @default(false)
  divine         Boolean            @default(false)
  pityTriggered  Boolean            @default(false) // dernière carte forcée en Mythique
  featuredHit    Boolean            @default(false) // au moins une carte vedette (bannière)
  zeniSpent      Int                @default(0) // prix payé pour ce booster (0 = stock gratuit)
  sealedDropId   String? // sachet scellé ouvert (Divin, Apocalyptique)
  apocalypse     ApocalypseOutcome? // issue d'un Apocalyptique
  createdAt      DateTime           @default(now())

  @@index([userId, createdAt])
}

// Gros tirage (Épique ou mieux) sorti d'un booster : carrousel « En direct » de l'accueil.
// Écrit dans la transaction d'ouverture ; la rareté affichée se règle à la lecture (home.pullFeed.*).
model NotablePull {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId           String
  card             Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rarity           String           @map("rarityKey")
  legacyRarity     Rarity           @default(COMMON) @map("rarity")
  rarityDefinition RarityDefinition @relation(fields: [rarity], references: [key])
  boosterSlug      String
  createdAt        DateTime         @default(now())

  @@index([createdAt])
  @@index([userId]) // suppression d'un compte (cascade)
}

// Carte déjà obtenue au moins une fois (badge « Nouveau », fiche wiki), même si elle a été revendue
model Discovery {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, cardId])
  @@index([userId, createdAt]) // missions « découvrir des cartes »
  @@index([cardId])
}

// Journal de toutes les écritures faites depuis /admin
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String // ex. SETTING_UPDATE, ROLE_GRANT
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// --- Types de boosters (étape 4) ---

enum BoosterKind {
  STANDARD
  RARITY
  FILTERED
  BANNER
  FORMAT
  DROP // sachet scellé (Divin, Apocalyptique) : tombe d'un booster, jamais en vente
}

enum BoosterShape {
  SACHET
  POCHIBUKURO
  JUBAKO
}

// Un booster proposé : filtre sur le catalogue, planchers, prix. Réglé dans /admin, chargé par seed.
model BoosterType {
  id              String          @id @default(cuid())
  slug            String          @unique
  kind            BoosterKind
  family          String // standard | formats | rarete | demographie | genre | personnage | epoque | special
  sortOrder       Int             @default(0)
  name            Json // { fr, en } (repli sur fr)
  tagline         Json // { fr, en }
  emblem          String // kanji de l'étiquette
  shape           BoosterShape    @default(SACHET)
  theme           Json // { base, dark, pattern, ink } (lib/boosters/types.ts)
  filter          Json            @default("{}") // PoolFilter (lib/boosters/pool-filter.ts)
  slotFloors      String[] // vide = réglage global booster.slotFloors
  usesFreeStock   Boolean         @default(true)
  priceZeni       Int? // prix en Zeni (payant, ou quand le stock gratuit est vide) ; null = pas d'achat
  countsForPity   Boolean         @default(true) // pitié Mythique partagée
  bonusEligible   Boolean         @default(true) // sachets doré et divin
  featuredCardIds String[] // cartes vedettes (bannière)
  featuredRate    Int             @default(5000) // points de base : part des tirages d'une rareté qui va aux vedettes
  featuredPity    Int             @default(100) // vedette garantie au N-ième booster sans vedette
  minPoolSize     Int? // sinon GameSetting booster.minPool
  poolCardIds     String[] // recalculé après import, seed ou modification admin
  poolCounts      Json? // { COMMON: n, … }
  poolComputedAt  DateTime?
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  credits         BoosterCredit[]
  sealedDrops     SealedDrop[]
  lotItems        LotItem[]

  @@index([family, sortOrder])
}

// --- Collection et profil (étape 5) ---

// Vitrine du profil : positions 1 à showcase.slots ; un exemplaire n'occupe qu'un emplacement
model ShowcaseSlot {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Int
  userCardId String   @unique
  userCard   UserCard @relation(fields: [userCardId], references: [id], onDelete: Cascade)

  @@id([userId, position])
}

// Une carte souhaitée n'a pas besoin d'être possédée. Vingt positions au maximum par profil.
model WishlistEntry {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now())

  @@id([userId, cardId])
  @@unique([userId, position])
  @@index([cardId])
}

// --- Social (étape 6) ---

enum FriendStatus {
  PENDING
  ACCEPTED
}

// Une seule ligne par paire de joueurs, quel que soit le sens de la demande (pairKey = ids triés)
model Friendship {
  id          String       @id @default(cuid())
  pairKey     String       @unique
  requesterId String
  requester   User         @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  // Refus silencieux : l'expéditeur voit toujours « Demande envoyée », le destinataire ne la voit plus
  declinedAt  DateTime?

  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// Blocage à sens unique ; aucun des deux ne peut plus demander, offrir ni notifier l'autre
model UserBlock {
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Après un refus ou une annulation : pas de nouvelle demande entre ces deux joueurs avant `until`
model FriendRequestCooldown {
  pairKey String   @id
  until   DateTime
}

enum GiftKind {
  CARD
  BOOSTER
  SEALED // sachet scellé tombé d'un tirage (offert une seule fois)
}

// Journal des cadeaux : quotas du jour et historique des cartes transférées
model Gift {
  id           String   @id @default(cuid())
  senderId     String
  sender       User     @relation("giftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User     @relation("giftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind         GiftKind
  cardId       String? // id de Card : reste lisible après recyclage ou revente
  userCardId   String? // exemplaire transféré
  sealedDropId String? // sachet scellé transféré
  zeniSpent    Int      @default(0)
  dayKey       String // jour du fuseau game.timeZone (AAAA-MM-JJ)
  createdAt    DateTime @default(now())

  @@index([senderId, dayKey])
  @@index([senderId, createdAt]) // missions hebdomadaires
  @@index([recipientId, dayKey])
  @@index([createdAt])
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GIFT_RECEIVED
  REFERRAL_QUALIFIED
  OUTBID // quelqu'un a surenchéri : la mise est rendue
  AUCTION_WON
  AUCTION_SOLD
  AUCTION_EXPIRED // aucune mise, la carte revient au vendeur
  AUCTION_CANCELLED // annulée par l'admin, mise rendue
  BATTLE_INVITE // un ami t'invite en combat avec un code
  SEALED_OPENED // l'ami a ouvert le sachet scellé que tu lui as offert
  LOT_GRANTED // cadeau de l'équipe (lot envoyé depuis /admin/lots)
  TRADE_PROPOSED // un ami propose un échange
  TRADE_ACCEPTED // l'ami a accepté : la carte voulue est arrivée
  TRADE_DECLINED // l'ami a refusé
  LISTING_OFFER // un joueur propose une carte sur ton annonce d'échange du Marché
  LISTING_ACCEPTED // ton offre a été acceptée : la carte est arrivée
  LISTING_DECLINED // ton offre a été refusée (ou l'annonce s'est fermée sans elle)
  TEAM_GIFT // cartes ou boosters ajoutés par l'équipe depuis la fiche du joueur (TeamGift)
}

// Notifications en base ; le texte est rendu à la lecture (pseudo à jour, langue du lecteur)
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("notified", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String?
  actor     User?            @relation("notifActor", fields: [actorId], references: [id], onDelete: Cascade)
  refId     String? // id de Friendship, de Gift…
  payload   Json             @default("{}") // ids et nombres uniquement, jamais de texte libre
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Abonnements Web Push (un par navigateur). L'endpoint est l'adresse du service push du
// navigateur : unique, un autre compte qui s'abonne depuis le même navigateur le reprend.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String // clé publique du navigateur (base64url)
  auth       String // secret d'authentification (base64url)
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// --- Économie (étape 7) ---

// Boosters à ouvrir, par type : cadeaux d'amis, boutique, missions, parrainage. Ouverts comme un
// cadeau : pitié Mythique comptée, sans booster doré ni divin.
model BoosterCredit {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  boosterTypeId String
  boosterType   BoosterType @relation(fields: [boosterTypeId], references: [id])
  count         Int         @default(0) // CHECK (count >= 0) dans la migration
  updatedAt     DateTime    @updatedAt

  @@id([userId, boosterTypeId])
}

enum SealedSource {
  DRAW // tombé d'un booster ouvert
  GIFT // offert par un ami (giverId)
  LOT // lot, mission, récompense
  ADMIN // donné depuis la fiche joueur
}

enum ApocalypseOutcome {
  SPARED // épargné : contenu d'un Divin
  RUINED // ruiné : Communes et Peu communes
}

// Sachet scellé (Divin, Apocalyptique) : un sachet = une ligne, pour savoir s'il peut s'offrir et
// à qui envoyer le résultat. Ouverture et cadeau passent par un updateMany conditionnel sur openedAt.
model SealedDrop {
  id            String       @id @default(cuid())
  ownerId       String
  owner         User         @relation("sealedOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  boosterTypeId String
  boosterType   BoosterType  @relation(fields: [boosterTypeId], references: [id])
  source        SealedSource
  giverId       String?
  giver         User?        @relation("sealedGiver", fields: [giverId], references: [id], onDelete: SetNull)
  giftable      Boolean      @default(false) // seul un sachet tombé d'un tirage s'offre, une fois
  openingId     String? // BoosterOpening créé à l'ouverture
  createdAt     DateTime     @default(now())
  openedAt      DateTime?

  @@index([ownerId, openedAt])
  @@index([giverId])
  @@index([boosterTypeId])
}

enum LotItemKind {
  BOOSTER // `quantity` boosters du type boosterTypeId
  CARD // `quantity` exemplaires de la carte cardId
  RARITY_CARD // `quantity` cartes tirées dans la rareté, pool du booster standard
}

// Récompense réutilisable (missions, parrainage, boutique)
model Lot {
  id         String         @id @default(cuid())
  name       Json // { fr, en }
  zeni       Int            @default(0)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      LotItem[]
  missions   Mission[]
  shopItems  ShopItem[]
  grants     LotGrant[]
  broadcasts LotBroadcast[]
}

model LotItem {
  id               String            @id @default(cuid())
  lotId            String
  lot              Lot               @relation(fields: [lotId], references: [id], onDelete: Cascade)
  kind             LotItemKind
  boosterTypeId    String?
  boosterType      BoosterType?      @relation(fields: [boosterTypeId], references: [id])
  cardId           String?
  card             Card?             @relation(fields: [cardId], references: [id])
  rarity           String?           @map("rarityKey")
  legacyRarity     Rarity?           @map("rarity")
  rarityDefinition RarityDefinition? @relation(fields: [rarity], references: [key])
  quantity         Int               @default(1)

  @@index([lotId])
}

enum MissionPeriod {
  DAILY
  WEEKLY
}

// Ce que compte une mission ; la progression est dérivée des journaux existants (pas de compteur)
enum MissionMetric {
  VISIT // passer sur le jeu (toujours accomplie)
  OPEN_BOOSTERS
  PULL_RARITY // cartes de rareté ≥ Mission.rarity tirées en booster
  DISCOVER_CARDS
  RECYCLE_ZENI // Zeni gagnés en recyclant
  SPEND_ZENI
  SEND_GIFTS
  ADD_FRIENDS
}

model Mission {
  id               String            @id @default(cuid())
  key              String            @unique // ex. daily-open-5
  period           MissionPeriod
  metric           MissionMetric
  goal             Int
  rarity           String?           @map("rarityKey") // PULL_RARITY seulement
  legacyRarity     Rarity?           @map("rarity")
  rarityDefinition RarityDefinition? @relation(fields: [rarity], references: [key])
  title            Json? // { fr, en } ; absent = texte généré depuis metric et goal
  lotId            String
  lot              Lot               @relation(fields: [lotId], references: [id])
  active           Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  claims           UserMission[]

  @@index([active, period, sortOrder])
}

// Une ligne = une récompense réclamée ; la clé primaire rend la double réclamation impossible
model UserMission {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])
  periodKey String // 2026-10-14 ou 2026-W42 (fuseau game.timeZone)
  claimedAt DateTime @default(now())

  @@id([userId, missionId, periodKey])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REVOKED
}

// Un filleul n'a qu'un parrain ; les récompenses ne sont versées qu'à la qualification
model Referral {
  id                String         @id @default(cuid())
  referrerId        String
  referrer          User           @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId         String         @unique
  referee           User           @relation("referee", fields: [refereeId], references: [id], onDelete: Cascade)
  status            ReferralStatus @default(PENDING)
  createdAt         DateTime       @default(now())
  qualifiedAt       DateTime?
  referrerClaimedAt DateTime?
  refereeClaimedAt  DateTime?

  @@index([referrerId, createdAt])
  @@index([createdAt])
}

enum ShopLimitPeriod {
  ONCE
  DAILY
  WEEKLY
}

// Article de la boutique : livre un lot. Les champs en euros restent inertes tant qu'aucun
// fournisseur de paiement n'est branché (server/payments).
model ShopItem {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          Json // { fr, en }
  description   Json // { fr, en }
  lotId         String
  lot           Lot              @relation(fields: [lotId], references: [id])
  priceZeni     Int? // null = pas d'achat en Zeni
  priceCents    Int? // prix en euros (paiement par carte, plus tard)
  stripePriceId String?
  perUserLimit  Int? // null = sans limite
  limitPeriod   ShopLimitPeriod?
  startsAt      DateTime?
  endsAt        DateTime?
  active        Boolean          @default(true)
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  purchases     Purchase[]

  @@index([active, sortOrder])
}

enum PurchaseCurrency {
  ZENI
  EUR
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Purchase {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopItemId  String
  shopItem    ShopItem         @relation(fields: [shopItemId], references: [id])
  currency    PurchaseCurrency
  amount      Int // Zeni ou centimes
  status      PurchaseStatus   @default(PENDING)
  provider    String? // fournisseur de paiement (EUR)
  providerRef String?          @unique // id de session ou de paiement chez le fournisseur
  periodKey   String // fenêtre de la limite d'achat : « all », jour ou semaine
  createdAt   DateTime         @default(now())
  paidAt      DateTime?

  @@index([userId, shopItemId, periodKey])
  @@index([createdAt])
}

// --- Hôtel des ventes (étape 8) ---

enum AuctionStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

// Une vente aux enchères en Zeni. La carte est réservée (UserCard.status = AUCTION) et la mise en
// tête est en séquestre : déjà débitée du meneur (BID_HOLD), rendue s'il est dépassé (BID_REFUND).
// Invariant : Σ soldes + Σ currentBid des ventes ACTIVE + Σ taxes (FEE) ne bouge pas.
// Dans la migration : une seule vente ACTIVE par exemplaire (index unique partiel) et CHECK sur les prix.
model Auction {
  id              String        @id @default(cuid())
  sellerId        String
  seller          User          @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  userCardId      String? // null si l'exemplaire a été recyclé après la vente
  userCard        UserCard?     @relation(fields: [userCardId], references: [id], onDelete: SetNull)
  cardId          String // la carte du catalogue : historique et filtres
  card            Card          @relation(fields: [cardId], references: [id])
  startPrice      Int
  buyoutPrice     Int? // achat immédiat ; proposé tant qu'aucune mise ne l'atteint
  currentBid      Int? // mise en tête, en séquestre
  currentBidderId String?
  currentBidder   User?         @relation("leader", fields: [currentBidderId], references: [id], onDelete: SetNull) // la suppression d'un compte (admin) remet d'abord la vente sans meneur
  price           Int // currentBid ?? startPrice, pour trier et filtrer
  bidCount        Int           @default(0)
  feeBp           Int // taxe figée à la mise en vente (points de base)
  endsAt          DateTime // repoussée par l'anti-sniping
  status          AuctionStatus @default(ACTIVE)
  finalPrice      Int?
  fee             Int?
  settledAt       DateTime?
  cancelledAt     DateTime?
  cancelledById   String? // vendeur ou admin
  note            String?       @db.VarChar(200) // commentaire du vendeur (texte brut, effaçable par l'admin)
  createdAt       DateTime      @default(now())
  bids            Bid[]

  @@index([status, endsAt, id]) // balayage de clôture et tri « finit bientôt »
  @@index([status, price, id])
  @@index([status, createdAt, id])
  @@index([sellerId, status])
  @@index([currentBidderId, status])
  @@index([cardId, status])
}

// Journal immuable des mises acceptées
model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
  @@index([bidderId, createdAt])
}

// Avis public d'un joueur (note + texte brut) : un par joueur, modifiable ; masqué par la modération
model Review {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int // 1 à 5, contrôlé par Zod et par une contrainte CHECK
  body      String // 1 000 caractères max, texte brut
  hidden    Boolean   @default(false)
  pinned    Boolean   @default(false) // en tête du carrousel de l'accueil ; jamais avec hidden (CHECK)
  pinnedAt  DateTime?
  reply     String? // réponse de l'équipe, texte brut, 1 000 caractères max (CHECK)
  repliedAt DateTime?
  // Les écritures de la modération passent par du SQL brut : elles ne touchent pas updatedAt,
  // qui reste la date de l'avis du joueur
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([hidden, updatedAt])
}

// --- Combat 1v1 en direct (étape 9) ---

enum BattleMode {
  FRIEND // salle privée avec un code, non classée
  EXHIBITION // file d'attente, non classée
  RANKED // file d'attente classée (étape 9b)
}

enum BattleStatus {
  WAITING // salle d'amis ouverte, en attente du second joueur
  ACTIVE
  FINISHED
  CANCELLED // salle expirée ou fermée avant le début
}

enum BattleEndReason {
  KO
  FORFEIT
  TIMEOUT // trop de tours expirés d'affilée
  TURN_LIMIT
}

// Une partie : setup figé + graine + actions (BattleAction) suffisent à la rejouer à l'identique.
// state est le cache de l'état courant ; version sert à la concurrence optimiste.
model Battle {
  id            String           @id @default(cuid())
  mode          BattleMode
  status        BattleStatus     @default(WAITING)
  code          String?          @unique // code ami tant que la salle attend
  codeExpiresAt DateTime?
  seed          Int // 0 ≤ seed < 2^31, tirée par le serveur
  p1Id          String
  p1            User             @relation("battleP1", fields: [p1Id], references: [id], onDelete: Cascade)
  p2Id          String? // null = bot
  p2            User?            @relation("battleP2", fields: [p2Id], references: [id], onDelete: Cascade)
  botName       String? // nom du bot affiché (lib/battle/bot.ts)
  p1Team        String[] // ids de UserCard (vides pour le bot)
  p2Team        String[]
  setup         Json? // BattleSetup (lib/battle/types.ts), posé au lancement
  state         Json? // BattleState courant
  version       Int              @default(0)
  turnEndsAt    DateTime?
  winnerSide    Int? // 0 = p1, 1 = p2, null = nul ou en cours
  endReason     BattleEndReason?
  rewardZeni    Int              @default(0) // versés au gagnant
  // Classé (étape 9b) : rang de chaque camp au lancement (couleur du plateau), PC avant et variation
  seasonId      String?
  season        Season?          @relation(fields: [seasonId], references: [id])
  p1Tier        String?
  p2Tier        String?
  pcBeforeP1    Int?
  pcBeforeP2    Int?
  pcDeltaP1     Int?
  pcDeltaP2     Int?
  crushing      Boolean          @default(false) // victoire écrasante
  createdAt     DateTime         @default(now())
  startedAt     DateTime?
  endedAt       DateTime?
  actions       BattleAction[]

  @@index([p1Id, createdAt])
  @@index([p2Id, createdAt])
  @@index([status, turnEndsAt])
}

// Journal des actions d'une partie, dans l'ordre (seq = BattleState.seq avant l'action)
model BattleAction {
  battleId  String
  battle    Battle   @relation(fields: [battleId], references: [id], onDelete: Cascade)
  seq       Int
  side      Int
  payload   Json // Action (lib/battle/types.ts)
  createdAt DateTime @default(now())

  @@id([battleId, seq])
}

// File d'attente : l'équipe est déjà bloquée (UserCard en BATTLE) ; seenAt prouve que le joueur attend encore
model BattleQueue {
  userId     String     @id
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       BattleMode
  rankPoints Int
  team       String[] // ids de UserCard
  joinedAt   DateTime   @default(now())
  seenAt     DateTime   @default(now())

  @@index([mode, joinedAt])
}

// --- Classé (étape 9b) ---

// Saison du classé, calée sur le calendrier (ranked.seasonMonths) ; closedAt pose la fin une seule fois
model Season {
  id       String         @id @default(cuid())
  number   Int            @unique
  startsAt DateTime
  endsAt   DateTime
  closedAt DateTime?
  results  SeasonResult[]
  battles  Battle[]

  @@index([closedAt, endsAt])
}

// Bilan d'un joueur en fin de saison ; la récompense (lot du meilleur rang atteint) se réclame une fois
model SeasonResult {
  seasonId  String
  season    Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalPc   Int
  peakPc    Int
  peakTier  String
  games     Int
  lotId     String?
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@id([seasonId, userId])
  @@index([userId, claimedAt])
}

// --- Conformité (étape 10) ---

enum LegalStatus {
  DRAFT
  PUBLISHED
}

// Une version d'une page légale dans une langue. La version en vigueur d'un slug est la plus haute
// version publiée ; l'anglais absent retombe sur le français de la même version.
model LegalPage {
  id            String      @id @default(cuid())
  slug          String // mentions-legales | confidentialite | cookies | cgu | cgv
  locale        String // fr | en
  version       Int
  title         String
  body          String // markdown, rendu sans HTML brut (react-markdown)
  status        LegalStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?       @relation(fields: [publishedById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([slug, locale, version])
  @@index([slug, status, version])
}

enum DataRequestKind {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  PENDING
  CANCELLED
  DONE
}

// Demandes RGPD (export, suppression) : historique du module « Données personnelles » de l'admin
model DataRequest {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("dataRequester", fields: [userId], references: [id], onDelete: Cascade)
  kind          DataRequestKind
  status        DataRequestStatus @default(PENDING)
  requestedAt   DateTime          @default(now())
  dueAt         DateTime? // suppression : anonymisation à cette date
  processedAt   DateTime?
  processedById String? // admin qui a exécuté ou annulé ; null = joueur ou cron
  processedBy   User?             @relation("dataProcessor", fields: [processedById], references: [id])

  @@index([kind, status, dueAt])
  @@index([userId, requestedAt])
}

// Lot envoyé par un admin à un joueur (seul ou dans un envoi à tous). La contrainte unique rend
// l'envoi à tous reprenable sans jamais verser deux fois au même joueur.
model LotGrant {
  id          String        @id @default(cuid())
  lotId       String
  lot         Lot           @relation(fields: [lotId], references: [id])
  userId      String
  user        User          @relation("lotGrantee", fields: [userId], references: [id], onDelete: Cascade)
  adminId     String
  admin       User          @relation("lotGranter", fields: [adminId], references: [id])
  broadcastId String?
  broadcast   LotBroadcast? @relation(fields: [broadcastId], references: [id])
  reason      String? // motif saisi par l'admin (200 caractères max), interne
  message     String?       @db.VarChar(200) // mot de l'équipe affiché au joueur avec la notification
  createdAt   DateTime      @default(now())

  @@unique([broadcastId, userId])
  @@index([userId, createdAt])
  @@index([lotId])
}

enum LotBroadcastStatus {
  RUNNING
  DONE
}

// Cartes ou boosters ajoutés par un admin depuis la fiche d'un joueur (mode « Ajouter ») : lu par la
// notification TEAM_GIFT, avec le mot de l'équipe. Ids de Card / BoosterType gardés en clair (lisibles
// après archivage), l'admin n'est jamais montré au joueur.
model TeamGift {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId       String
  kind          GiftKind
  cardId        String?
  boosterTypeId String?
  quantity      Int
  message       String?  @db.VarChar(200)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// Envoi d'un lot à tous les joueurs, traité par paquets (budget de temps) et reprenable
model LotBroadcast {
  id         String             @id @default(cuid())
  lotId      String
  lot        Lot                @relation(fields: [lotId], references: [id])
  adminId    String
  admin      User               @relation(fields: [adminId], references: [id])
  audience   String // ALL | REGISTERED (jamais les bannis ni les comptes anonymisés)
  reason     String?
  message    String?            @db.VarChar(200) // mot de l'équipe affiché aux joueurs
  status     LotBroadcastStatus @default(RUNNING)
  lastUserId String? // curseur : dernier joueur traité (ordre des ids)
  granted    Int                @default(0)
  createdAt  DateTime           @default(now())
  finishedAt DateTime?
  grants     LotGrant[]

  @@index([status, createdAt])
}

// --- Échanges entre amis (étape 12f) ---

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED // retiré par le proposant
  EXPIRED
  FAILED // une carte n'était plus disponible au moment d'accepter
}

// « Je veux ta carte X, contre l'une de celles-ci. » Rien n'est bloqué pendant l'attente : tout est
// revérifié sous verrou à l'acceptation, où l'ami choisit une des cartes offertes.
model Trade {
  id             String       @id @default(cuid())
  proposerId     String
  proposer       User         @relation("tradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      User         @relation("tradeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  wantedCardId   String // carte demandée à l'ami (id de Card)
  wantedCard     Card         @relation("tradeWanted", fields: [wantedCardId], references: [id], onDelete: Cascade)
  chosenCardId   String? // carte offerte choisie par l'ami à l'acceptation
  chosenCard     Card?        @relation("tradeChosen", fields: [chosenCardId], references: [id], onDelete: SetNull)
  status         TradeStatus  @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?
  proposerSeenAt DateTime? // le proposant a vu la révélation de la carte reçue
  proposerNew    Boolean      @default(false) // la carte reçue par le proposant était nouvelle pour lui (badge à la révélation)
  note           String?      @db.VarChar(200) // mot du proposant (texte brut)
  declineNote    String?      @db.VarChar(200) // motif du refus, écrit par l'ami
  offers         TradeOffer[]

  @@index([recipientId, status, createdAt])
  @@index([proposerId, status, createdAt])
  @@index([status, expiresAt])
}

// Une carte offerte par le proposant (id de Card ; l'exemplaire est choisi à l'acceptation)
model TradeOffer {
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([tradeId, cardId])
}

// --- Échanges ouverts du Marché ---

enum ListingStatus {
  OPEN
  TRADED
  CANCELLED // retirée par son auteur
  EXPIRED
  FAILED // la carte de l'auteur n'était plus disponible à l'acceptation
}

// « Je donne celle-ci contre l'une de celles-là », ouvert à tous les joueurs. Rien n'est bloqué
// pendant l'attente : tout est revérifié sous verrou quand l'auteur accepte une offre.
model TradeListing {
  id         String             @id @default(cuid())
  ownerId    String
  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cardId     String // carte donnée (id de Card ; l'exemplaire est choisi à l'acceptation)
  card       Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  status     ListingStatus      @default(OPEN)
  expiresAt  DateTime
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?
  note       String?            @db.VarChar(200) // commentaire public de l'auteur (texte brut, effaçable par l'admin)
  wants      TradeListingWant[]
  offers     ListingOffer[]

  @@index([status, createdAt, id])
  @@index([status, expiresAt])
  @@index([ownerId, status])
  @@index([cardId, status])
}

// Une carte demandée par l'auteur (qu'il ne possède pas à la création)
model TradeListingWant {
  listingId String
  listing   TradeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([listingId, cardId])
  @@index([cardId])
}

enum ListingOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN // retirée par l'offrant
  CLOSED // annonce conclue avec un autre, retirée ou expirée
  FAILED // la carte de l'offrant n'était plus disponible à l'acceptation
}

// Offre d'un joueur sur une annonce : une de ses cartes, demandée ou non
model ListingOffer {
  id           String             @id @default(cuid())
  listingId    String
  listing      TradeListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId     String
  bidder       User               @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  cardId       String // carte proposée (id de Card)
  card         Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fromWants    Boolean // la carte faisait partie des cartes demandées
  status       ListingOfferStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  resolvedAt   DateTime?
  bidderSeenAt DateTime? // l'offrant a vu la révélation de la carte reçue
  bidderNew    Boolean            @default(false) // la carte reçue était nouvelle pour l'offrant
  declineNote  String?            @db.VarChar(200) // motif du refus, écrit par l'auteur de l'annonce

  @@index([listingId, status])
  @@index([bidderId, status, createdAt])
}

// --- Chat entre amis (étape 12g) ---

// Message privé entre deux amis. Texte brut (jamais de HTML), purgé après chat.retentionDays.
model ChatMessage {
  id          String    @id @default(cuid())
  pairKey     String // ids des deux joueurs triés (comme Friendship)
  senderId    String
  sender      User      @relation("chatSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("chatRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String    @db.VarChar(500)
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([pairKey, createdAt])
  @@index([recipientId, readAt])
  @@index([createdAt])
}

// --- Personnalisation du profil (étape 12h) ---

enum TitleAgreement {
  MASC
  FEM
}

enum CosmeticKind {
  TITLE
  FRAME
  NAME_COLOR
}

// Titre, cadre d'avatar ou couleur de pseudo, débloqué par une condition (lib/profile/conditions.ts), géré dans /admin/cosmetiques.
model Cosmetic {
  id           String       @id @default(cuid())
  kind         CosmeticKind
  slug         String       @unique
  label        Json // { fr, frFem?, en }
  hint         Json         @default("{}") // { fr, en } : comment le débloquer
  frameStyle   String? // style visuel d'un cadre (lib/profile/frames.ts)
  nameColor    String? // style d'une couleur de pseudo (lib/profile/name-colors.ts)
  condition    Json // ProfileCondition
  sortOrder    Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  titledUsers  User[]       @relation("userTitle")
  framedUsers  User[]       @relation("userFrame")
  coloredUsers User[]       @relation("userNameColor")

  @@index([kind, active, sortOrder])
}
